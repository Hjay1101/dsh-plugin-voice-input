{
  "name": "dsh-plugin-voice-input",
  "version": "0.1.0",
  "description": "DeepSeek Harness voice input plugin: record audio in the Web GUI, transcribe it through pluggable STT providers (Alibaba Bailian, Xiaomi MiMo, or any OpenAI-compatible endpoint) with priority failover, and fill the composer draft — the model you selected still executes the request.",
  "license": "MIT",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "plugin",
    "voice",
    "speech-to-text",
    "stt",
    "asr",
    "aliyun",
    "bailian",
    "dashscope",
    "xiaomi",
    "mimo"
  ],
  "type": "module",
  "main": "./index.js",
  "files": [
    "index.js",
    "client.js",
    "typert.host.js",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./typert": "./typert.host.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "react": "^18.2.0",
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/schemastery": "^3.18.1",
    "@deepseek-ai/dsh-typert-protocol": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-credentials": "^0.1.0-rc.6"
  }
}
